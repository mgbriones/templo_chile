{#
  WELLHUB BANNER — franja de color bajo la portada que anuncia el convenio con
  Wellhub. Toda la franja es un enlace a la sección #wellhub.
  Textos: textos.yml > wellhub_banner.
-#}
<a href="#wellhub" class="wellhub-banner">
  <div class="contenedor wellhub-banner__contenido">
    <span class="wellhub-banner__titulo">{{ textos.wellhub_banner.titulo }}</span>
    <span class="wellhub-banner__bajada">{{ textos.wellhub_banner.bajada }}</span>
  </div>
</a>
